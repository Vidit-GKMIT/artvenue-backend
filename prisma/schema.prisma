// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum VenueCategory {
  Hotel
  Bar
  Restaurant
  Club
}


// Seeded Table

model roles {
  id         Int       @id @default(autoincrement())
  role       String    @db.VarChar(15)
  created_at DateTime  @default(now()) @db.Timestamp()
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime? @db.Timestamp()

  users users[]
}

model categories {
  id            Int                @id @default(autoincrement())
  category_name String             @unique @db.VarChar(30)
  created_at    DateTime           @default(now()) @db.Timestamp()
  updated_at    DateTime           @default(now()) @updatedAt @db.Timestamp()
  deleted_at    DateTime?          @db.Timestamp()

  artist_categories artist_categories[]
  event_categories  event_categories[]
}

//----

model users {
  id         Int       @id @default(autoincrement())
  name       String     @unique @db.VarChar(25)
  email      String    @unique @db.VarChar(40)
  password   String    @db.VarChar(80)
  role_id    Int 
  created_at DateTime  @default(now()) @db.Timestamp()
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime? @db.Timestamp()

  
  role    roles?    @relation(fields: [role_id], references: [id])
  artists artists[] 
  venues  venues[]  
}

model artists {
  id         Int       @id @default(autoincrement())
  user_id    Int 
  age        Int
  created_at DateTime  @default(now()) @db.Timestamp()
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime? @db.Timestamp()

  
  user              users?               @relation(fields: [user_id], references: [id])
  artist_categories artist_categories[] 
  opt_ins           opt_ins[]            
}

model venues {
  id         Int             @id @default(autoincrement())
  owner_id   Int             
  category   VenueCategory?
  name       String          @db.VarChar(30)
  address    String          @db.Text
  created_at DateTime        @default(now()) @db.Timestamp()
  updated_at DateTime        @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime?       @db.Timestamp()

  owner  users     @relation(fields: [owner_id], references: [id])
  events events[]  
}

model events {
  id              Int       @id @default(autoincrement())
  venue_id        Int       
  event_name      String    @db.VarChar(30)
  payout          Int
  start_date_time DateTime  @db.Timestamp()
  end_date_time   DateTime  @db.Timestamp()
  capacity        Int
  created_at      DateTime  @default(now()) @db.Timestamp()
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at      DateTime? @db.Timestamp()

  venue            venues            @relation(fields: [venue_id], references: [id])
  event_categories event_categories[]
  opt_ins          opt_ins[]          
}

model artist_categories {
  id          Int       @id @default(autoincrement())
  artist_id   Int
  category_id Int
  created_at  DateTime  @default(now()) @db.Timestamp()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime? @db.Timestamp()

  artist   artists   @relation(fields: [artist_id], references: [id])
  category categories @relation(fields: [category_id], references: [id])

  @@unique([artist_id, category_id])
}

model event_categories {
  id          Int       @id @default(autoincrement())
  event_id    Int
  category_id Int
  created_at  DateTime  @default(now()) @db.Timestamp()
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at  DateTime? @db.Timestamp()

  event    events    @relation(fields: [event_id], references: [id])
  category categories @relation(fields: [category_id], references: [id])

  @@unique([event_id, category_id])
}

model opt_ins {
  id         Int       @id @default(autoincrement())
  artist_id  Int       
  event_id   Int       
  created_at DateTime  @default(now()) @db.Timestamp()
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp()
  deleted_at DateTime? @db.Timestamp()

  artist artists @relation(fields: [artist_id], references: [id])
  event  events  @relation(fields: [event_id], references: [id])
}